    { "type": "sentence", "id": "sentence.he_is_boring", "tl": "Ele é aborrecido.", "ar": "هو مُمِل.", "say": "إيل إي أبوغيسيدو", "marks": [{ "text": "é", "group": "a" }] },
    { "type": "sentence", "id": "sentence.he_is_bored", "tl": "Ele está aborrecido.", "ar": "هو يشعر بالملل.", "say": "إيل إشتا أبوغيسيدو", "marks": [{ "text": "está", "group": "b" }] },
    { "type": "sentence", "id": "sentence.soup_good_always", "tl": "A sopa é boa.", "ar": "الشوربة لذيذة دائمًا.", "say": "أ سوپا إي بوا", "marks": [{ "text": "é", "group": "a" }] },
    { "type": "sentence", "id": "sentence.soup_good_today", "tl": "A sopa está boa.", "ar": "الشوربة لذيذة اليوم.", "say": "أ سوپا إشتا بوا", "marks": [{ "text": "está", "group": "b" }] },
    { "type": "sentence", "id": "sentence.estou_bem", "tl": "Estou bem.", "ar": "أنا بخير.", "say": "إشتو باين", "marks": [{ "text": "Estou", "group": "b" }] },
    { "type": "sentence", "id": "sentence.estas_cansado", "tl": "Estás cansado?", "ar": "هل أنت متعب؟", "say": "إشتاش كانسادو", "marks": [{ "text": "Estás", "group": "b" }] },
    { "type": "sentence", "id": "sentence.ela_esta_em_casa", "tl": "Ela está em casa.", "ar": "هي في البيت.", "say": "إيلا إشتا إين كازا", "marks": [{ "text": "está", "group": "b" }] },
    { "type": "sentence", "id": "sentence.estamos_no_cafe", "tl": "Estamos no café.", "ar": "نحن في المقهى.", "say": "إشتامُش نو كافي", "marks": [{ "text": "Estamos", "group": "b" }, { "text": "no", "group": "prep" }] },
    { "type": "sentence", "id": "sentence.eles_estao_atrasados", "tl": "Eles estão atrasados.", "ar": "هم متأخرون.", "say": "إيليش إشتاون أتغازادوش", "marks": [{ "text": "estão", "group": "b" }] }
